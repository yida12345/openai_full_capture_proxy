# Claude Code 的 ANTHROPIC_BASE_URL 指向此监听地址。
PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=30303

# 必须是完整的 OpenAI Chat Completions URL。
OPENAI_UPSTREAM_URL=http://127.0.0.1:8000/v1/chat/completions
OPENAI_MODEL=openai/GLM-5.1

# 本地无认证服务可留空。不要把真实密钥提交到版本库。
OPENAI_API_KEY=

# 每次评测 run 建议使用独立目录。
CAPTURE_LOG_DIR=./capture_logs/example_run
UPSTREAM_TIMEOUT_SECONDS=300

# OpenAI 兼容服务的可选能力开关。
OPENAI_REASONING_MODE=preserve
OPENAI_REASONING_FIELD=reasoning_content
OPENAI_TOKEN_LIMIT_FIELD=max_tokens
OPENAI_STREAM_INCLUDE_USAGE=true
OPENAI_MAP_REASONING_EFFORT=true
OPENAI_EXTRA_BODY_JSON={}
OPENAI_EXTRA_HEADERS_JSON={}
